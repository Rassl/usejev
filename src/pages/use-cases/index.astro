---
import Base from '../../layouts/Base.astro';
import CatalogCard from '../../components/CatalogCard.astro';
import { getCatalog, topicsOf } from '../../lib/catalog';
import { breadcrumbs } from '../../lib/jsonld';

const items = await getCatalog();
const topics = topicsOf(items);
const projects = items.filter((i) => i.kind === 'project').length;
const guides = items.length - projects;
---

<Base
  title="Jev Use Cases: Real Projects and Guides with Code"
  description="What people build with Jev, TypeSafe AI's System One model: real projects rated by Jev itself, next to worked guides with verified Python and TypeScript code."
  jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Use cases', path: '/use-cases/' }])]}
>
  <h1>Jev use cases</h1>
  <p class="lede">
    {projects} real projects people have posted, best first as rated by Jev itself, and {guides} guides with working
    code that show how to build the same things. Claims in posts belong to their authors.
  </p>

  <div class="filters" id="filters">
    <fieldset data-group="kind">
      <legend>Show</legend>
      <button type="button" class="chip" aria-pressed="true" data-value="">Everything</button>
      <button type="button" class="chip" aria-pressed="false" data-value="project">Real projects</button>
      <button type="button" class="chip" aria-pressed="false" data-value="guide">Guides with code</button>
    </fieldset>
    <fieldset data-group="topic">
      <legend>Topic</legend>
      <button type="button" class="chip" aria-pressed="true" data-value="">All topics</button>
      {topics.map(([t, n]) => <button type="button" class="chip" aria-pressed="false" data-value={t}>{t} <span class="chip-n">{n}</span></button>)}
    </fieldset>
  </div>
  <p class="filter-status" id="filter-status" role="status" aria-live="polite"></p>
  <ul class="ugrid" id="catalog">
    {items.map((i) => <CatalogCard item={i} heading="h2" />)}
  </ul>
  <p class="cta-row"><a class="btn btn-primary" href="/submit/">Built something with Jev? Submit it</a></p>
</Base>

<script is:inline>
  (() => {
    const filters = document.getElementById('filters');
    const status = document.getElementById('filter-status');
    const cards = [...document.querySelectorAll('#catalog .ucard')];
    const active = { kind: '', topic: '' };
    // Links such as /use-cases/?topic=Agents or ?show=project open with the filter applied.
    const params = new URLSearchParams(location.search);
    const apply = () => {
      let shown = 0;
      for (const card of cards) {
        const match = (!active.kind || card.dataset.kind === active.kind) && (!active.topic || card.dataset.topic === active.topic);
        card.hidden = !match;
        if (match) shown++;
      }
      for (const chip of filters.querySelectorAll('.chip')) chip.setAttribute('aria-pressed', String(active[chip.parentElement.dataset.group] === chip.dataset.value));
      status.textContent = active.kind || active.topic ? `Showing ${shown} of ${cards.length}` : '';
    };
    filters.addEventListener('click', (event) => {
      const chip = event.target.closest('.chip');
      if (!chip) return;
      active[chip.parentElement.dataset.group] = chip.dataset.value;
      apply();
    });
    active.kind = params.get('show') || '';
    active.topic = params.get('topic') || '';
    if (active.kind || active.topic) apply();
  })();
</script>
