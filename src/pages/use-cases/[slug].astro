---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import CodeTabs from '../../components/CodeTabs.astro';
import CostTable from '../../components/CostTable.astro';
import UseCaseCard from '../../components/UseCaseCard.astro';
import Readout from '../../components/Readout.astro';
import SightingCard from '../../components/SightingCard.astro';
import { exampleAnswers, exampleState } from '../../lib/readout';
import { getSightings } from '../../lib/sightings';

export async function getStaticPaths() {
  const entries = await getCollection('use-cases');
  const byId = new Map(entries.map((e) => [e.id, e]));
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      related: entry.data.related.map((id) => {
        const match = byId.get(id);
        if (!match) throw new Error(`${entry.id}: related use case "${id}" does not exist`);
        return match;
      }),
    },
  }));
}

const { entry, related } = Astro.props;
const { Content, headings } = await render(entry);
const answers = exampleAnswers(entry.body ?? '');
const state = exampleState(entry.body ?? '');
const sightings = (await getSightings()).filter((x) => x.data.useCases.includes(entry.id));
const d = entry.data;
---

<Article
  title={d.title}
  description={d.description}
  path={`/use-cases/${entry.id}/`}
  section={{ name: 'Use cases', path: '/use-cases/' }}
  publishedAt={d.publishedAt}
  updatedAt={d.updatedAt}
  proficiency={d.difficulty}
  headings={headings}
>
  <ul class="tags" slot="meta" aria-label="Tags">
    {d.primitives.map((p) => <li class="tag tag-primitive">{p}</li>)}
    <li class="tag">{d.category}</li>
    {d.industry.map((i) => <li class="tag">{i}</li>)}
    <li class="tag">{d.difficulty}</li>
  </ul>

  {answers && (
    <figure class="glance" slot="lead">
      <figcaption>
        <span class="eyebrow">At a glance</span>
        One request: a <code>state</code> goes in, typed answers come out. Numbers are illustrative.
      </figcaption>
      <div class="glance-grid">
        {state && (
          <div class="glance-state">
            <span class="glance-label">state</span>
            <pre tabindex="0"><code>{state}</code></pre>
          </div>
        )}
        <div class="glance-answers">
          <span class="glance-label">answers</span>
          <Readout answers={answers} />
        </div>
      </div>
    </figure>
  )}

  <Content components={{ CodeTabs, CostTable }} />

  {sightings.length > 0 && (
    <section class="related" slot="after" aria-labelledby="wild-heading">
      <h2 id="wild-heading">Seen in the wild</h2>
      <p class="meta">Public posts about this pattern. Claims belong to their authors. <a href="/community/">See all posts about Jev in the wild</a> or <a href="/submit/">submit one you have seen</a>.</p>
      <ul class="sightings">
        {sightings.slice(0, 4).map((x) => <SightingCard sighting={x} />)}
      </ul>
    </section>
  )}

  <section class="related" slot="after" aria-labelledby="related-heading">
    <h2 id="related-heading">Related use cases</h2>
    <ul class="grid">
      {related.map((r) => <UseCaseCard entry={r} />)}
    </ul>
    <p><a href="/use-cases/">Browse all Jev use cases</a></p>
  </section>
</Article>
