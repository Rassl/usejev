---
// /community/ is only generated when at least one sighting is published, so an empty page never
// reaches the sitemap. In `npm run dev`, drafts count too.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SightingCard from '../components/SightingCard.astro';
import { getSightings } from '../lib/sightings';
import { breadcrumbs } from '../lib/jsonld';

export async function getStaticPaths() {
  const sightings = await getSightings();
  return sightings.length ? [{ params: { community: 'community' } }] : [];
}

const sightings = await getSightings();
const useCases = await getCollection('use-cases');
const titles = new Map(useCases.map((u) => [u.id, u.data.title.replace(/ with Jev$/, '')]));
for (const s of sightings) {
  for (const slug of s.data.useCases) {
    if (!titles.has(slug)) throw new Error(`sighting ${s.id}: unknown use case "${slug}"`);
  }
}
const used = [...new Set(sightings.flatMap((s) => s.data.useCases))];
const categories = [...new Set(sightings.map((s) => s.data.category).filter((c): c is string => Boolean(c)))].sort();
---

<Base
  title="Jev in the Wild: How People Use It"
  description="Public posts from developers showing how they use Jev in real projects, linked to the original and matched to a worked use case with code."
  jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'In the wild', path: '/community/' }])]}
>
  <h1>Jev in the wild</h1>
  <p class="lede">
    Public posts showing how people use Jev, newest first. Each card quotes a short excerpt, links to the original, and points to the
    closest <a href="/use-cases/">worked use case</a>. Claims in these posts belong to their authors and are not
    verified by this site.
  </p>
  <p class="cta-row"><a class="btn btn-primary" href="/submit/">Submit a post about using Jev</a></p>

  {(used.length > 1 || categories.length > 1) && (
    <div class="filters" id="sighting-filters">
      {categories.length > 1 && (
        <fieldset data-group="category">
          <legend>Category</legend>
          {categories.map((c) => <button type="button" class="chip" aria-pressed="false" data-value={c}>{c}</button>)}
        </fieldset>
      )}
      {used.length > 1 && (
        <fieldset data-group="usecases">
          <legend>Closest worked use case</legend>
          {used.map((slug) => <button type="button" class="chip" aria-pressed="false" data-value={slug}>{titles.get(slug)}</button>)}
        </fieldset>
      )}
    </div>
  )}
  <p class="filter-status" id="sighting-status" role="status" aria-live="polite"></p>

  <ul class="sightings" id="sightings">
    {sightings.map((s) => <SightingCard sighting={s} titles={titles} heading="h2" />)}
  </ul>
</Base>

<script is:inline>
  (() => {
    const filters = document.getElementById('sighting-filters');
    if (!filters) return;
    const status = document.getElementById('sighting-status');
    const cards = [...document.querySelectorAll('#sightings .sighting')];
    const active = { category: new Set(), usecases: new Set() };
    filters.addEventListener('click', (event) => {
      const chip = event.target.closest('.chip');
      if (!chip) return;
      const set = active[chip.parentElement.dataset.group];
      const on = chip.getAttribute('aria-pressed') !== 'true';
      chip.setAttribute('aria-pressed', String(on));
      on ? set.add(chip.dataset.value) : set.delete(chip.dataset.value);
      let shown = 0;
      for (const card of cards) {
        const match = Object.entries(active).every(([group, wanted]) => {
          if (!wanted.size) return true;
          const have = card.dataset[group].split('|');
          return [...wanted].some((v) => have.includes(v));
        });
        card.hidden = !match;
        if (match) shown++;
      }
      const filtered = active.category.size + active.usecases.size > 0;
      status.textContent = filtered ? `Showing ${shown} of ${cards.length} posts` : '';
    });
  })();
</script>
