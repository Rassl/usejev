---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import UseCaseCard from '../components/UseCaseCard.astro';
import Readout from '../components/Readout.astro';
import SightingCard from '../components/SightingCard.astro';
import { SITE, DOCS, GUIDES } from '../lib/site';
import { getSightings } from '../lib/sightings';
import type { Answer } from '../lib/readout';

const latestSightings = (await getSightings()).slice(0, 3);

// Illustrative numbers, the same example as /use-cases/support-ticket-routing/.
const demoState = `{
  "subject": "Charged twice this month",
  "body": "Hi, I see two charges of $49 on my
    card for September. Can you refund one?"
}`;
const demoAnswers: Record<string, Answer> = {
  queue: {
    type: 'choice',
    choice: 'billing',
    probabilities: { billing: 0.95, technical: 0.02, account_access: 0.01, sales: 0.01, other: 0.01 },
    confidence: 0.9,
  },
  frustration: {
    type: 'score',
    score: 0.45,
    legend: { '0': 'Calm', '1': 'Frustrated', '2': 'Very angry' },
    probabilities: { '0': 0.6, '1': 0.35, '2': 0.05 },
    confidence: 0.62,
  },
  is_outage_report: { type: 'noul', noul: 0.02 },
};

const entries = (await getCollection('use-cases')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || a.data.title.localeCompare(b.data.title),
);
const industries = [...new Set(entries.flatMap((e) => e.data.industry))].sort();
const primitives = ['Choice', 'Score', 'Noul'];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: SITE.shortName,
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'en',
  },
];
---

<Base title={SITE.name} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Unofficial field guide to TypeSafe AI's Jev</p>
      <h1>Practical Jev use cases, <em>with working code</em></h1>
      <p class="lede">
        <a href={DOCS.vendor}>Jev</a> is a "System One" model: you send a <code>state</code> (an email, a log line, a
        ticket, any JSON) plus a list of typed questions. It answers every question in parallel with a Choice, a Score,
        or a Noul (yes/no) value, each backed by probabilities, instead of generated text. Your code branches on those
        answers and uses confidence to decide when to act and when to escalate.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/use-cases/">Browse all use cases</a>
        <a class="btn" href="/guides/what-is-jev/">What is Jev?</a>
      </div>
    </div>
    <figure class="demo">
      <div class="demo-state">
        <span class="glance-label">state</span>
        <pre><code>{demoState}</code></pre>
      </div>
      <div class="demo-answers">
        <span class="glance-label">answers · 3 questions, 1 request</span>
        <Readout answers={demoAnswers} />
      </div>
      <figcaption>
        Illustrative numbers in the documented response shape. Worked through in the{' '}
        <a href="/use-cases/support-ticket-routing/">support ticket routing use case</a>.
      </figcaption>
    </figure>
  </section>

  <section aria-labelledby="grid-heading">
    <h2 id="grid-heading">Jev use cases</h2>
    <div class="filters" id="filters">
      <fieldset data-group="primitives">
        <legend>Question type</legend>
        {primitives.map((p) => <button type="button" class="chip" aria-pressed="false" data-value={p}>{p}</button>)}
      </fieldset>
      <fieldset data-group="industries">
        <legend>Industry</legend>
        {industries.map((i) => <button type="button" class="chip" aria-pressed="false" data-value={i}>{i}</button>)}
      </fieldset>
    </div>
    <p class="filter-status" id="filter-status" role="status" aria-live="polite"></p>
    <ul class="grid" id="use-case-grid">
      {entries.map((e) => <UseCaseCard entry={e} />)}
    </ul>
  </section>

  {latestSightings.length > 0 && (
    <section aria-labelledby="wild-heading">
      <h2 id="wild-heading">Jev in the wild</h2>
      <ul class="sightings">
        {latestSightings.map((x) => <SightingCard sighting={x} />)}
      </ul>
      <p class="cta-row">
        <a class="btn" href="/community/">See all posts about Jev in the wild</a>
        <a class="btn btn-primary" href="/submit/">Submit your own</a>
      </p>
    </section>
  )}

  <section aria-labelledby="guides-heading">
    <h2 id="guides-heading">Guides</h2>
    <ul class="grid">
      {GUIDES.map((g) => (
        <li class="card">
          <h3><a href={g.href}>{g.title}</a></h3>
          <p>{g.blurb}</p>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="docs-heading">
    <h2 id="docs-heading">Go to the source</h2>
    <p>
      This is an unofficial community site. API details change, so treat the
      <a href={DOCS.home}>official TypeSafe documentation</a> as the source of truth, starting with the
      <a href={DOCS.api}>HTTP API reference</a> and the <a href={DOCS.jaggedness}>list of known Jev limitations</a>.
    </p>
    <p><a class="btn btn-primary" href={DOCS.home}>Read the official Jev docs</a></p>
  </section>
</Base>

<script is:inline>
  (() => {
    const filters = document.getElementById('filters');
    const status = document.getElementById('filter-status');
    const cards = [...document.querySelectorAll('#use-case-grid .card')];
    if (!filters) return;
    const active = { primitives: new Set(), industries: new Set() };
    filters.addEventListener('click', (event) => {
      const chip = event.target.closest('.chip');
      if (!chip) return;
      const set = active[chip.parentElement.dataset.group];
      const on = chip.getAttribute('aria-pressed') !== 'true';
      chip.setAttribute('aria-pressed', String(on));
      on ? set.add(chip.dataset.value) : set.delete(chip.dataset.value);
      let shown = 0;
      for (const card of cards) {
        const match = Object.entries(active).every(([group, wanted]) => {
          if (!wanted.size) return true;
          const have = card.dataset[group].split('|');
          return [...wanted].some((v) => have.includes(v));
        });
        card.hidden = !match;
        if (match) shown++;
      }
      const filtered = active.primitives.size + active.industries.size > 0;
      status.textContent = filtered ? `Showing ${shown} of ${cards.length} use cases` : '';
    });
  })();
</script>
