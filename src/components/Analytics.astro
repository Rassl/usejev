---
// Yandex.Metrika counter. Runs only on the production host, and only after the page has loaded,
// so it never competes with rendering. Config matches the snippet from the Metrika dashboard.
const COUNTER_ID = 112802419;
---

<script is:inline define:vars={{ COUNTER_ID }}>
  (function () {
    if (location.hostname !== 'usejev.dev') return;
    function start() {
      (function (m, e, t, r, i, k, a) {
        m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) return; }
        k = e.createElement(t); a = e.getElementsByTagName(t)[0]; k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
      })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=' + COUNTER_ID, 'ym');

      ym(COUNTER_ID, 'init', {
        ssr: true,
        webvisor: true,
        clickmap: true,
        ecommerce: 'dataLayer',
        referrer: document.referrer,
        url: location.href,
        accurateTrackBounce: true,
        trackLinks: true,
      });
    }
    function whenIdle() {
      'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 4000 }) : setTimeout(start, 1500);
    }
    document.readyState === 'complete' ? whenIdle() : addEventListener('load', whenIdle, { once: true });
  })();
</script>
<noscript><div><img src={`https://mc.yandex.ru/watch/${COUNTER_ID}`} style="position:absolute; left:-9999px;" alt="" /></div></noscript>
