---
// How Jev fits into an app, as one picture: your app sends a state and typed questions, Jev
// answers with probabilities (no text), and your own code decides what happens next.
// Numbers are illustrative and match /use-cases/support-ticket-routing/.
const answers = [
  { id: 'queue', type: 'Choice', value: 'billing', bar: 0.95, note: 'confidence 0.90' },
  { id: 'frustration', type: 'Score', value: '0.45 of 2', bar: 0.225, note: 'calm to frustrated' },
  { id: 'is_outage_report', type: 'Noul', value: '0.02', bar: 0.02, note: 'almost certainly no' },
];
---

<figure class="flow" aria-labelledby="flow-caption">
  <ol class="flow-row">
    <li class="flow-step">
      <p class="flow-kicker"><span class="flow-num">1</span> Your app sends</p>
      <div class="flow-box">
        <div class="flow-ticket">
          <span class="flow-tag">state</span>
          <strong>Charged twice this month</strong>
          <span>Hi, I see two charges of $49 on my card for September. Can you refund one?</span>
        </div>
        <ul class="flow-questions" aria-label="Questions sent with the state">
          <li><span class="flow-tag">Choice</span> Which queue?</li>
          <li><span class="flow-tag">Score</span> How frustrated?</li>
          <li><span class="flow-tag">Noul</span> Is it an outage report?</li>
        </ul>
      </div>
    </li>

    <li class="flow-link" aria-hidden="true"><span>one request</span></li>

    <li class="flow-step">
      <p class="flow-kicker"><span class="flow-num">2</span> Jev answers</p>
      <div class="flow-box flow-model">
        <p class="flow-model-name"><span class="brand-mark">?:</span> Jev <small>System One model</small></p>
        <ul class="flow-answers">
          {answers.map((a) => (
            <li>
              <span class="flow-answer-head"><code>{a.id}</code><b>{a.value}</b></span>
              <span class="flow-bar"><i style={`width:${Math.max(a.bar * 100, 2)}%`}></i></span>
              <span class="flow-answer-note">{a.type} · {a.note}</span>
            </li>
          ))}
        </ul>
        <p class="flow-foot">Probabilities, not generated text</p>
      </div>
    </li>

    <li class="flow-link" aria-hidden="true"><span>typed answers</span></li>

    <li class="flow-step">
      <p class="flow-kicker"><span class="flow-num">3</span> Your code decides</p>
      <div class="flow-box">
        <ul class="flow-rules">
          <li class="is-on">
            <code>queue = billing, confidence ≥ 0.8</code>
            <span>Route to Billing, no person needed</span>
          </li>
          <li class="is-on">
            <code>frustration &lt; 1</code>
            <span>Normal priority</span>
          </li>
          <li class="is-on">
            <code>is_outage_report &lt; 0.5</code>
            <span>Do not page on-call</span>
          </li>
          <li class="is-off">
            <code>confidence &lt; 0.8</code>
            <span>Otherwise: hand to a person</span>
          </li>
        </ul>
      </div>
    </li>
  </ol>
  <figcaption id="flow-caption">
    Illustrative numbers in the documented response shape. The full example, with code, is the{' '}
    <a href="/use-cases/support-ticket-routing/">support ticket routing guide</a>.
  </figcaption>
</figure>

<style>
  .flow {
    margin: 0;
  }
  .flow-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: minmax(0, 1fr);
  }
  .flow-step {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .flow-kicker {
    margin: 0 0 0.5rem;
    font: 700 0.95rem var(--display);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .flow-num {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--surface);
    font: 700 0.8rem var(--mono);
  }
  .flow-box {
    flex: 1;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .flow-tag {
    font: 600 0.68rem var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 4px;
    padding: 0.05rem 0.4rem;
    width: fit-content;
  }

  .flow-box:not(.flow-model) {
    justify-content: center;
  }

  /* 1. the request */
  .flow-ticket {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border: 1px dashed var(--line);
    border-radius: 8px;
    padding: 0.7rem 0.8rem;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .flow-ticket strong {
    color: var(--ink);
    font-size: 0.95rem;
  }
  .flow-questions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.9rem;
  }
  .flow-questions li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .flow-questions .flow-tag {
    min-width: 3.6rem;
    text-align: center;
  }

  /* 2. the model */
  .flow-model {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .flow-model-name {
    margin: 0;
    font: 700 1.05rem var(--mono);
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  .flow-model-name small {
    font: 500 0.75rem var(--sans);
    color: var(--muted);
    margin-left: auto;
  }
  .flow-model-name .brand-mark {
    margin-right: 0.15rem;
  }
  .flow-answers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .flow-answer-head {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .flow-answer-head code {
    background: none;
    padding: 0;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .flow-answer-head b {
    font-family: var(--mono);
    color: var(--accent);
    white-space: nowrap;
  }
  .flow-bar {
    display: block;
    height: 0.45rem;
    margin: 0.25rem 0 0.2rem;
    border-radius: 99px;
    background: var(--line);
    overflow: hidden;
  }
  .flow-bar i {
    display: block;
    height: 100%;
    border-radius: 99px;
    background: var(--accent);
    transform-origin: left;
  }
  .flow-answer-note {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .flow-foot {
    margin: auto 0 0;
    font-size: 0.78rem;
    color: var(--muted);
    border-top: 1px solid var(--line);
    padding-top: 0.6rem;
  }

  /* 3. the decision */
  .flow-rules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .flow-rules li {
    display: grid;
    gap: 0.15rem;
    border-radius: 8px;
    padding: 0.5rem 0.65rem 0.55rem 2rem;
    position: relative;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .flow-rules code {
    background: none;
    padding: 0;
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--muted);
  }
  .flow-rules li::before {
    position: absolute;
    left: 0.65rem;
    top: 0.5rem;
    font: 700 0.95rem var(--mono);
  }
  .flow-rules .is-on {
    background: color-mix(in srgb, #1f8a4c 11%, var(--surface));
  }
  .flow-rules .is-on::before {
    content: '✓';
    color: #1f8a4c;
  }
  .flow-rules .is-off {
    border: 1px dashed var(--line);
    color: var(--muted);
    font-weight: 500;
  }
  .flow-rules .is-off::before {
    content: '↳';
  }

  /* connectors: vertical on small screens, horizontal on wide ones */
  .flow-link {
    display: grid;
    place-items: center;
    padding-block: 0.15rem;
    font: 600 0.7rem var(--mono);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .flow-link span {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }
  .flow-link span::after {
    content: '';
    width: 2px;
    height: 1.4rem;
    background: repeating-linear-gradient(to bottom, var(--accent) 0 5px, transparent 5px 9px);
    background-size: 2px 9px;
  }
  @media (min-width: 60rem) {
    .flow-row {
      grid-template-columns: minmax(0, 1fr) 5.5rem minmax(0, 1fr) 5.5rem minmax(0, 1fr);
      gap: 0;
      align-items: stretch;
    }
    .flow-link {
      padding: 2rem 0.4rem 0;
    }
    .flow-link span {
      width: 100%;
      text-align: center;
      line-height: 1.2;
    }
    .flow-link span::after {
      width: 100%;
      height: 2px;
      margin-top: 0.3rem;
      background: repeating-linear-gradient(to right, var(--accent) 0 5px, transparent 5px 9px);
      background-size: 9px 2px;
      /* arrow head */
      -webkit-mask: linear-gradient(#000 0 0);
      mask: linear-gradient(#000 0 0);
    }
    .flow-link span::before {
      content: '▶';
      order: 3;
      align-self: flex-end;
      margin: -0.62rem -0.1rem 0 0;
      font-size: 0.6rem;
      color: var(--accent);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .flow-link span::after {
      animation: flow-march 0.7s linear infinite;
    }
    .flow-bar i {
      animation: flow-grow 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: 0.35s;
    }
  }
  @keyframes flow-march {
    to {
      background-position: 9px 9px;
    }
  }
  @keyframes flow-grow {
    from {
      transform: scaleX(0);
    }
  }
  figcaption {
    margin-top: 0.8rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
</style>
