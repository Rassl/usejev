---
// How Jev fits into an app, as a picture. Read left to right: a customer message comes in, you
// ask Jev three typed questions about it, Jev gives one typed answer per question (same row,
// same icon), and your app acts on the answers. Few words on purpose.
// Numbers are illustrative and match /use-cases/support-ticket-routing/.
---

<figure class="flow" aria-labelledby="flow-caption">
  <div class="flow-track">
    <!-- the message -->
    <div class="flow-node">
      <div class="flow-bubble">“I was charged twice!”</div>
      <div class="flow-disc flow-disc-customer">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <circle cx="32" cy="26" r="15" fill="currentColor" opacity="0.14" />
          <circle cx="32" cy="26" r="15" fill="none" stroke="currentColor" stroke-width="3" />
          <path d="M22 20l7 3M42 20l-7 3" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
          <circle cx="26.5" cy="26.5" r="1.8" fill="currentColor" /><circle cx="37.5" cy="26.5" r="1.8" fill="currentColor" />
          <path d="M26 35c3.5-3.4 8.5-3.4 12 0" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
          <path d="M10 60c2-11 11-16 22-16s20 5 22 16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        </svg>
      </div>
      <p class="flow-name">Customer</p>
    </div>

    <div class="flow-wire" aria-hidden="true"><i></i></div>

    <!-- what you ask -->
    <div class="flow-col">
      <p class="flow-head">You ask Jev</p>
      <ul class="flow-lanes flow-in">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13l3-8h12l3 8v6H3z M3 13h5l1.5 3h5L16 13h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg><span>Which queue?</span><small>Choice</small></li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" /><path d="M8 9.5l2.5 1M16 9.5l-2.5 1M8.5 16c2-1.8 5-1.8 7 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg><span>How frustrated?</span><small>Score</small></li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 19v-6a6 6 0 0 1 12 0v6M4 19h16M12 3v2M4.5 6.5 6 8M19.5 6.5 18 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg><span>Is it an outage?</span><small>Noul</small></li>
      </ul>
    </div>

    <!-- the model -->
    <div class="flow-jev">
      <div class="flow-cube">
        <svg viewBox="0 0 140 182" aria-hidden="true">
          <defs>
            <linearGradient id="flow-top" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7fe3ff" /><stop offset="1" stop-color="#3b82ff" /></linearGradient>
            <linearGradient id="flow-left" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2f7bff" /><stop offset="1" stop-color="#1a2fb8" /></linearGradient>
            <linearGradient id="flow-right" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5b6bff" /><stop offset="1" stop-color="#6d3df0" /></linearGradient>
          </defs>
          <g class="flow-slab">
            <path d="M70 112l56 30-56 30-56-30z" fill="#38c6ff" fill-opacity="0.18" stroke="#38c6ff" stroke-width="1.5" />
            <path d="M14 142l56 30v8l-56-30z" fill="#2f7bff" fill-opacity="0.35" stroke="#38c6ff" stroke-width="1" />
            <path d="M126 142l-56 30v8l56-30z" fill="#6d3df0" fill-opacity="0.35" stroke="#38c6ff" stroke-width="1" />
          </g>
          <path d="M70 8l54 30-54 30-54-30z" fill="url(#flow-top)" fill-opacity="0.92" />
          <path d="M16 38l54 30v60l-54-30z" fill="url(#flow-left)" fill-opacity="0.9" />
          <path d="M124 38l-54 30v60l54-30z" fill="url(#flow-right)" fill-opacity="0.9" />
          <path d="M70 8l54 30v60l-54 30-54-30v-60zM16 38l54 30 54-30M70 68v60" fill="none" stroke="#bfeaff" stroke-width="1.5" stroke-linejoin="round" stroke-opacity="0.85" />
        </svg>
        <span class="flow-mark">?:</span>
        <svg class="flow-bolt" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h6l-1 8 9-12h-6z" fill="currentColor" /></svg>
      </div>
      <p class="flow-name">Jev</p>
    </div>

    <!-- what comes back -->
    <div class="flow-col">
      <p class="flow-head">Jev answers</p>
      <ul class="flow-lanes flow-out">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13l3-8h12l3 8v6H3z M3 13h5l1.5 3h5L16 13h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg><b>Billing</b><em>95% sure</em></li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" /><path d="M8 9.5l2.5 1M16 9.5l-2.5 1M8.5 16c2-1.8 5-1.8 7 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg><span class="flow-meter" role="img" aria-label="Frustration 0.45 on a scale of 0 to 2"><i style="left:22.5%"></i></span><em>0.45 of 2</em></li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 19v-6a6 6 0 0 1 12 0v6M4 19h16M12 3v2M4.5 6.5 6 8M19.5 6.5 18 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg><b>No</b><em>2% chance</em></li>
      </ul>
    </div>

    <div class="flow-wire" aria-hidden="true"><i></i></div>

    <!-- what your app does -->
    <div class="flow-node">
      <div class="flow-disc flow-disc-done">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <circle cx="24" cy="24" r="9" fill="currentColor" opacity="0.14" /><circle cx="24" cy="24" r="9" fill="none" stroke="currentColor" stroke-width="3" />
          <path d="M8 54c1-10 7-15 16-15s15 5 16 15" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
          <path d="M14 24a10 10 0 0 1 20 0" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
          <rect x="11" y="23" width="5" height="8" rx="2" fill="currentColor" /><rect x="32" y="23" width="5" height="8" rx="2" fill="currentColor" />
          <circle cx="47" cy="17" r="11" fill="var(--ok)" /><path d="M41.5 17.5l4 4 7-8" fill="none" stroke="#04122a" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <p class="flow-name">Billing team</p>
      <p class="flow-sub">your app routes it</p>
      <p class="flow-else">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="2" /><path d="M4 21c1-5 4-7 8-7s7 2 8 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        not sure? a person decides
      </p>
    </div>
  </div>
  <figcaption id="flow-caption">
    One request, no generated text. Illustrative numbers. Switch to Python, TypeScript or HTTP above to see the code.
  </figcaption>
</figure>

<style>
  .flow {
    /* A night scene in both themes: deep navy, glass panels, neon wires. */
    --ok: #35e394;
    --hot: #ff5a6e;
    --surface: #070d26;
    --ink: #eaf1ff;
    --muted: #8fa6d8;
    --line: rgba(120, 165, 255, 0.3);
    --accent: #38c6ff;
    --accent-soft: rgba(56, 198, 255, 0.12);
    --violet: #8b6bff;
    --lane: 2.9rem; /* height of one question/answer row */
    --lane-gap: 0.7rem;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    margin: 0;
    color: var(--ink);
    background:
      radial-gradient(1px 1px at 12% 22%, #9fd4ff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 31% 78%, #7fb6ff 50%, transparent 51%),
      radial-gradient(1px 1px at 58% 14%, #b9a6ff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 77% 84%, #7fe3ff 50%, transparent 51%),
      radial-gradient(1px 1px at 91% 30%, #9fd4ff 50%, transparent 51%),
      radial-gradient(42rem 22rem at 50% 45%, rgba(40, 110, 255, 0.32), transparent 70%),
      radial-gradient(26rem 16rem at 92% 100%, rgba(139, 107, 255, 0.28), transparent 70%),
      radial-gradient(26rem 16rem at 5% 0%, rgba(0, 200, 255, 0.16), transparent 70%),
      linear-gradient(160deg, #040818, #070d26 55%, #0a0f33);
    border: 1px solid rgba(90, 150, 255, 0.35);
    border-radius: 20px;
    box-shadow: 0 24px 60px -30px rgba(20, 70, 220, 0.7), inset 0 0 0 1px rgba(255, 255, 255, 0.03);
    padding: 1.75rem 1.25rem 1.1rem;
  }
  /* a lit floor grid fading into the dark */
  .flow::before {
    content: '';
    position: absolute;
    inset: 55% -10% -30%;
    z-index: -1;
    background:
      linear-gradient(rgba(56, 198, 255, 0.22) 1px, transparent 1px) 0 0 / 100% 2.2rem,
      linear-gradient(90deg, rgba(56, 198, 255, 0.22) 1px, transparent 1px) 0 0 / 2.2rem 100%;
    transform: perspective(30rem) rotateX(62deg);
    transform-origin: top;
    mask-image: linear-gradient(to bottom, transparent, #000 35%, transparent 95%);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 35%, transparent 95%);
  }
  .flow-track {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 1rem;
  }
  .flow-node,
  .flow-jev {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* the round pictures */
  .flow-disc {
    position: relative;
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 2px solid currentColor;
    background: linear-gradient(160deg, color-mix(in srgb, currentColor 22%, transparent), rgba(8, 14, 44, 0.75));
    box-shadow:
      0 0 28px color-mix(in srgb, currentColor 45%, transparent),
      inset 0 0 22px color-mix(in srgb, currentColor 22%, transparent);
    backdrop-filter: blur(6px);
  }
  .flow-disc svg {
    filter: drop-shadow(0 0 6px color-mix(in srgb, currentColor 70%, transparent));
  }
  .flow-disc svg {
    width: 4.3rem;
    height: 4.3rem;
  }
  .flow-disc-customer {
    color: var(--hot);
  }
  .flow-disc-done {
    color: #9fd4ff;
  }
  /* the model: a lit cube on a slab */
  .flow-cube {
    position: relative;
    width: 9rem;
    filter: drop-shadow(0 0 22px rgba(56, 140, 255, 0.75));
  }
  .flow-cube > svg:first-child {
    display: block;
    width: 100%;
    height: auto;
  }
  .flow-mark {
    position: absolute;
    left: 50%;
    top: 37%;
    transform: translate(-50%, -50%);
    font: 800 2.5rem var(--mono);
    color: #fff;
    text-shadow: 0 0 14px #7fe3ff, 0 0 3px #04122a;
  }
  .flow-bolt {
    position: absolute;
    right: 0.1rem;
    top: -0.4rem;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0.35rem;
    color: #04122a;
    background: linear-gradient(135deg, #7fe3ff, #38c6ff);
    border-radius: 50%;
    box-shadow: 0 0 14px #38c6ff;
  }
  .flow-name {
    margin: 0.6rem 0 0;
    font: 700 1.2rem var(--display);
    color: var(--ink);
  }
  .flow-sub {
    margin: 0.1rem 0 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ok);
  }
  .flow-else {
    margin: 0.6rem 0 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.76rem;
    color: var(--muted);
    border: 1px dashed var(--line);
    border-radius: 99px;
    padding: 0.2rem 0.65rem 0.2rem 0.45rem;
    white-space: nowrap;
  }
  .flow-else svg {
    width: 1rem;
    height: 1rem;
  }
  .flow-bubble {
    position: relative;
    margin-bottom: 0.85rem;
    padding: 0.4rem 0.85rem;
    border-radius: 14px;
    background: linear-gradient(135deg, #ff5a6e, #d83a9a);
    box-shadow: 0 0 22px rgba(255, 90, 110, 0.55);
    color: #fff;
    font: 700 1rem var(--display);
    white-space: nowrap;
  }
  .flow-bubble::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.4rem;
    width: 0.85rem;
    height: 0.85rem;
    background: #ea4a84;
    transform: translateX(-50%) rotate(45deg);
    border-radius: 2px;
  }

  /* questions in, answers out: same rows, same icons */
  .flow-col {
    width: min(100%, 17rem);
  }
  .flow-head {
    margin: 0 0 0.6rem;
    font: 700 0.78rem var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-align: center;
    color: #7fe3ff;
    text-shadow: 0 0 10px rgba(56, 198, 255, 0.6);
  }
  .flow-lanes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--lane-gap);
  }
  .flow-lanes li {
    position: relative;
    height: var(--lane);
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0 0.8rem;
    border-radius: 12px;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .flow-lanes svg {
    width: 1.3rem;
    height: 1.3rem;
    flex: none;
  }
  .flow-in li {
    border: 1px solid var(--line);
    background: linear-gradient(160deg, rgba(60, 110, 255, 0.16), rgba(8, 14, 44, 0.6));
    backdrop-filter: blur(6px);
    color: var(--ink);
    font-weight: 600;
  }
  .flow-in svg {
    color: var(--muted);
  }
  .flow-in small {
    margin-left: auto;
    font: 600 0.66rem var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .flow-out li {
    background: linear-gradient(160deg, rgba(56, 198, 255, 0.24), rgba(109, 61, 240, 0.2));
    border: 1px solid var(--accent);
    box-shadow: 0 0 18px rgba(56, 198, 255, 0.35), inset 0 0 14px rgba(56, 198, 255, 0.12);
    backdrop-filter: blur(6px);
    color: #fff;
  }
  .flow-out svg {
    color: var(--accent);
  }
  .flow-out b {
    font-size: 1.05rem;
  }
  .flow-out em {
    margin-left: auto;
    font: 600 0.78rem var(--mono);
    font-style: normal;
    color: var(--accent);
  }
  .flow-meter {
    position: relative;
    width: 5rem;
    height: 0.5rem;
    border-radius: 99px;
    background: linear-gradient(to right, var(--ok), #e0a526, var(--hot));
  }
  .flow-meter i {
    position: absolute;
    top: 50%;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: #fff;
    border: 3px solid #04122a;
    box-shadow: 0 0 10px #fff;
    transform: translate(-50%, -50%);
  }

  /* wires */
  .flow-wire i,
  .flow-in li::after,
  .flow-out li::before {
    filter: drop-shadow(0 0 4px #38c6ff);
  }
  .flow-wire i {
    display: block;
    width: 3px;
    height: 1.6rem;
    background: repeating-linear-gradient(to bottom, #7fe3ff 0 6px, transparent 6px 12px);
    background-size: 3px 12px;
  }

  @media (min-width: 75rem) {
    .flow {
      padding: 2rem 1.75rem 1.2rem;
    }
    .flow-track {
      grid-template-columns: auto 2.75rem minmax(max-content, 1fr) auto minmax(max-content, 1fr) 2.75rem auto;
      align-items: center;
      gap: 0;
    }
    .flow-col {
      width: 100%;
    }
    /* headings sit above the rows without pushing them off the shared centre line */
    .flow-col,
    .flow-node,
    .flow-jev {
      position: relative;
    }
    .flow-head {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 100%;
    }
    .flow-jev .flow-name,
    .flow-node:last-child .flow-name {
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      white-space: nowrap;
    }
    .flow-node:last-child .flow-sub,
    .flow-node:last-child .flow-else {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      white-space: nowrap;
    }
    .flow-node:last-child .flow-sub { top: calc(100% + 2.2rem); }
    .flow-node:last-child .flow-else { top: calc(100% + 3.6rem); }
    .flow-node:first-child .flow-bubble {
      position: absolute;
      bottom: 100%;
      margin-bottom: 0.75rem;
    }
    .flow-node:first-child .flow-name {
      position: absolute;
      top: 100%;
    }
    .flow-track {
      padding-block: 3.4rem 5.6rem; /* room for the bubble above and the labels below */
    }
    .flow-jev {
      margin-inline: 1.75rem;
    }
    /* wide enough for the bubble above and the labels below, so they never touch a neighbour */
    .flow-node {
      min-width: 10.5rem;
    }
    /* each row is wired to the model: question -> Jev -> answer */
    .flow-in li::after,
    .flow-out li::before {
      content: '';
      position: absolute;
      top: 50%;
      width: 1.75rem;
      height: 3px;
      margin-top: -1.5px;
      background: repeating-linear-gradient(to right, #7fe3ff 0 6px, transparent 6px 12px);
      background-size: 12px 3px;
    }
    .flow-in li::after { left: 100%; margin-left: 2px; }
    .flow-out li::before { right: 100%; margin-right: 2px; }
    .flow-wire i {
      width: 100%;
      height: 3px;
      background: repeating-linear-gradient(to right, #7fe3ff 0 6px, transparent 6px 12px);
      background-size: 12px 3px;
    }
    .flow-wire {
      justify-self: stretch;
      position: relative;
      padding-inline: 0.3rem;
    }
    .flow-wire::after {
      content: '';
      position: absolute;
      right: 0;
      top: 50%;
      margin-top: -6px;
      border: 6px solid transparent;
      border-left: 9px solid var(--accent);
      border-right: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .flow-wire i,
    .flow-in li::after,
    .flow-out li::before {
      animation: flow-march 0.6s linear infinite;
    }
    .flow-disc-customer {
      animation: flow-shake 2.6s ease-in-out infinite;
    }
    .flow-cube {
      animation: flow-pulse 2.6s ease-in-out infinite, flow-float 4s ease-in-out infinite;
    }
    .flow-out li {
      animation: flow-pop 0.5s both;
    }
    .flow-out li:nth-child(1) { animation-delay: 0.5s; }
    .flow-out li:nth-child(2) { animation-delay: 0.7s; }
    .flow-out li:nth-child(3) { animation-delay: 0.9s; }
  }
  @keyframes flow-march {
    to { background-position: 12px 12px; }
  }
  @keyframes flow-shake {
    0%, 86%, 100% { transform: rotate(0); }
    89% { transform: rotate(-5deg); }
    92% { transform: rotate(5deg); }
    95% { transform: rotate(-3deg); }
  }
  @keyframes flow-pulse {
    50% { filter: drop-shadow(0 0 36px rgba(90, 130, 255, 0.95)); }
  }
  @keyframes flow-float {
    50% { transform: translateY(-4px); }
  }
  @keyframes flow-pop {
    from { opacity: 0; transform: translateX(-8px); }
  }
  figcaption {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
