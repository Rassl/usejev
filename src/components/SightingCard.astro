---
import { SOURCE_LABEL, type Sighting } from '../lib/sightings';

interface Props {
  sighting: Sighting;
  titles?: Map<string, string>; // use-case slug -> title, to render tag links
  heading?: 'h2' | 'h3';
}
const { sighting, titles, heading: H = 'h3' } = Astro.props;
const d = sighting.data;
const source = SOURCE_LABEL[d.source];
const date = d.postedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const initial = d.author.name.trim().charAt(0).toUpperCase();
---

<li
  class="sighting"
  data-usecases={d.useCases.join('|')}
  data-category={d.category ?? ''}
  data-posted={d.postedAt.toISOString()}
  data-relevance={d.relevance?.score ?? -1}
>
  <article>
    <header class="sighting-head">
      <span class="sighting-avatar" aria-hidden="true">{initial}</span>
      <span class="sighting-who">
        <span class="sighting-name">{d.author.name}</span>
        {d.author.handle && <span class="sighting-handle">@{d.author.handle}</span>}
      </span>
      <span class="sighting-source" title={`Posted on ${source.name}`}>{source.short}</span>
    </header>
    {d.title && <H class="sighting-title">{d.title}</H>}
    {d.media && (
      <a class="sighting-media" href={d.url} rel="noopener nofollow ugc" tabindex="-1" aria-hidden="true">
        <img src={d.media.thumbnail} alt="" width="640" height="360" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
        {d.media.type === 'video' && <span class="sighting-play">Video on {source.name}</span>}
      </a>
    )}
    <blockquote cite={d.url}>
      {d.text.split(/\n{2,}/).map((para) => <p>{para}</p>)}
    </blockquote>
    {d.summary && <p class="sighting-summary">{d.summary}</p>}
    {(d.category || d.primitives.length > 0 || d.useCases.length > 0) && (
      <ul class="tags" aria-label="Related">
        {d.category && <li class="tag">{d.category}</li>}
        {d.primitives.map((p) => <li class="tag tag-primitive">{p}</li>)}
        {d.useCases.map((slug) => (
          <li class="tag"><a href={`/use-cases/${slug}/`}>{titles?.get(slug) ?? slug}</a></li>
        ))}
      </ul>
    )}
    <footer class="sighting-foot">
      <time datetime={d.postedAt.toISOString()}>{date}</time>
      <a href={d.url} rel="noopener nofollow ugc">View the original on {source.name}<span class="sr-only"> by {d.author.name}</span></a>
    </footer>
    {d.draft && <p class="sighting-draft">Draft: visible in development only</p>}
  </article>
</li>
