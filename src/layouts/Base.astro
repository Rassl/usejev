---
import '../styles/global.css';
import { SITE, DOCS } from '../lib/site';
import { getSightings } from '../lib/sightings';
import Analytics from '../components/Analytics.astro';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
  markdownPath?: string;
}

const { title, description, ogType = 'website', jsonLd = [], noindex = false, publishedAt, updatedAt, markdownPath } = Astro.props;

const suffix = ` | ${SITE.shortName}`;
const fullTitle = title.includes(SITE.shortName) || (title + suffix).length > 60 ? title : title + suffix;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(SITE.ogImage, SITE.url).href;
const path = Astro.url.pathname;
const hasCommunity = (await getSightings()).length > 0;
const nav = [
  { href: '/use-cases/', label: 'Use cases' },
  { href: '/guides/what-is-jev/', label: 'What is Jev?' },
  { href: '/guides/jev-vs-llm-classification/', label: 'Jev vs LLMs' },
  { href: '/guides/confidence-thresholds/', label: 'Confidence' },
  ...(hasCommunity ? [{ href: '/community/', label: 'In the wild' }] : []),
  { href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {markdownPath && <link rel="alternate" type="text/markdown" href={new URL(markdownPath, SITE.url).href} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.shortName} new use cases`} href={new URL('/rss.xml', SITE.url).href} />
    <meta name="theme-color" content="#f2f4f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1316" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="usejev.dev, unofficial Jev use cases with working code" />
    <meta property="og:locale" content="en_US" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/" aria-label="usejev.dev home">
          <span class="brand-mark" aria-hidden="true">?:</span>usejev<span class="brand-tld">.dev</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
            <li><a class="nav-cta" href="/submit/" aria-current={path.startsWith('/submit/') ? 'page' : undefined}>Submit a post</a></li>
            <li class="nav-icons">
              <a class="nav-icon" href={SITE.repo} rel="noopener" aria-label="Source code on GitHub" title="Source code on GitHub">
                <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
              </a>
              <a class="nav-icon" href={SITE.x} rel="noopener me" aria-label="The maintainer on X" title="The maintainer on X">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644Z"/></svg>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="disclaimer"><strong>{SITE.disclaimer}</strong></p>
        <p>
          Jev and TypeSafe are names of their respective owner. For authoritative information, read the
          <a href={DOCS.home} rel="noopener">official TypeSafe documentation</a>.
        </p>
        <ul class="footer-links">
          <li><a href="/use-cases/">All use cases</a></li>
          <li><a href="/guides/what-is-jev/">What is Jev?</a></li>
          <li><a href="/guides/jev-vs-llm-classification/">Jev vs LLMs for classification</a></li>
          <li><a href="/guides/confidence-thresholds/">Confidence thresholds</a></li>
          {hasCommunity && <li><a href="/community/">Jev in the wild</a></li>}
          <li><a href="/submit/">Submit a post about Jev</a></li>
          <li><a href="/about/">About this site</a></li>
          <li><a href="/rss.xml">RSS feed</a></li>
          <li><a href="/llms.txt">llms.txt for AI agents</a></li>
          <li><a href={SITE.repo} rel="noopener">Source on GitHub</a></li>
          <li><a href={SITE.x} rel="noopener me">Maintainer on X</a></li>
        </ul>
      </div>
    </footer>
    <Analytics />
  </body>
</html>
